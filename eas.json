{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_FCM_TOKEN_DEBUG": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "mock": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://issueissyu-ai.cloud"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
