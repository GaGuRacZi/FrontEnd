{
  "expo": {
    "name": "PAW",
    "slug": "paw",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#8CA9FF",
    "icon": "./assets/images/paw-logo.png",
    "scheme": "paw",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "androidStatusBar": {
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "enforceContrast": false
    },
    "splash": {
      "image": "./assets/images/paw-main-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "backgroundColor": "#FFFFFF",
      "package": "com.gaguraczi.paw",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/paw-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/paw-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/paw-main-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
