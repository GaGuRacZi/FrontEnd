{
  "expo": {
    "name": "PAW",
    "slug": "paw",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#8CA9FF",
    "icon": "./assets/images/paw-logo.png",
    "scheme": "paw",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "androidStatusBar": {
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF",
      "enforceContrast": false
    },
    "splash": {
      "image": "./assets/images/paw-main-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "allowBackup": false,
      "backgroundColor": "#FFFFFF",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.gaguraczi.paw",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/paw-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/paw-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/noto-sans-kr/400Regular/NotoSansKR_400Regular.ttf",
            "./node_modules/@expo-google-fonts/noto-sans-kr/500Medium/NotoSansKR_500Medium.ttf",
            "./node_modules/@expo-google-fonts/noto-sans-kr/700Bold/NotoSansKR_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필, 반려동물, 문서 또는 게시물에 사진을 첨부하려면 사진 접근 권한이 필요합니다.",
          "cameraPermission": "처방전 사진을 촬영하려면 카메라 권한이 필요합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "진료 내용을 녹음하려면 마이크 권한이 필요합니다.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 기반으로 지역을 설정하려면 위치 권한이 필요합니다.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/paw-main-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@react-native-firebase/messaging",
      "@react-native-firebase/app",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "161e7309-40dc-4434-8465-73544396a9dc"
      }
    },
    "owner": "ah_young"
  }
}